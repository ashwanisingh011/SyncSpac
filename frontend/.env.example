# Core API endpoint of the backend service
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# URL of the socket server (usually same host as backend)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# The domain URL where this frontend is hosted
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay Client Key ID (obtained from Razorpay Dashboard -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
