{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "next/navigation": ["./src/lib/next-navigation-compat.ts"],
      "next/link": ["./src/lib/next-link-compat.tsx"],
      "next/image": ["./src/lib/next-image-compat.tsx"],
      "next": ["./src/lib/next-types-compat.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
